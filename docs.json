  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "pages": [
          "index",
          "overview",
          "quickstart"
        ]
      },
      {
        "group": "Technical Documentation",
        "icon": "book-open",
        "pages": [
          "architecture",
          "frontend",
          "backend",
          "security",
          "deployment",
          "developer-guide"
        ]
      }
    ]
  }
