{
  "$schema": "https://mintlify.com",
  "theme": "mint",
  "name": "Rejesha Green",
  "colors": {
    "primary": "#22C55E",
    "light": "#4ADE80",
    "dark": "#16A34A"
  },
  "logo": {
    "light": "/logo/rejesha-logo.png",
    "dark": "/logo/rejesha-logo.png",
    "href": "/",
    "height": 70
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "styling": {
    "codeblocks": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 700
    },
    "body": {
      "family": "Inter"
    }
  },
  "navigation": {
    "tabs": [],
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "overview",
          "quickstart"
        ]
      },
      {
        "group": "Architecture & Core Concepts",
        "pages": [
          "architecture",
          "security"
        ]
      },
      {
        "group": "Platform Guides",
        "pages": [
          "frontend",
          "backend",
          "deployment",
          "developer-guide"
        ]
      }
    ]
  },
  "enableLlmTxt": true,
  "assistant": {
    "version": "v2"
  }
}
