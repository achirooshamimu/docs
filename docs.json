{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rejesha Green Technical Documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#22C55E",
    "dark": "#15803D"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "appearance": {
  "default": "system",
  "strict": false
},
"styling": {
  "codeblocks": "dark"
}
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B0F0C"
    }
