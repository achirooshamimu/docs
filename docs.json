{
  "$schema": "https://mintlify.com",
  "theme": "mint",
  "name": "Rejesha Green Technical Documentation",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#4C1D95"
  },
  "logo": {
    "light": "/logo/rejesha-logo.png",
    "dark": "/logo/rejesha-logo.png",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "styling": {
    "codeblocks": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F8FAFC",
      "dark": "#0B0D10"
    }
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "pages": [
          "index",
          "overview",
          "quickstart"
        ]
      },
      {
        "group": "Technical Documentation",
        "icon": "book-open",
        "pages": [
          "architecture",
          "frontend",
          "backend",
          "security",
          "deployment",
          "developer-guide"
        ]
      }
    ]
  }
}
